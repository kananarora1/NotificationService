# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# docker compose reads .env from this directory automatically for ${VAR} substitution.
# To run the app on the host with these values:
#
#   set -a; source .env; set +a; ./mvnw spring-boot:run
#
# Every value below is a LOCAL DEVELOPMENT placeholder. Generate real secrets for any
# deployed environment — see "Configuration & secrets" in the README.

# ---- Postgres ----
# DB_URL is the JDBC url the app connects with; POSTGRES_* configure the container.
DB_URL=jdbc:postgresql://localhost:5433/notifications
DB_USERNAME=notifications
DB_PASSWORD=change-me
POSTGRES_DB=notifications
# Host port for Postgres; 5433 avoids colliding with a native Postgres on 5432.
POSTGRES_PORT=5433

# ---- RabbitMQ ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=change-me
# Management UI port (http://localhost:15672)
RABBITMQ_MANAGEMENT_PORT=15672

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for a local Redis with no auth.
REDIS_PASSWORD=

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000

# ---- Prometheus ----
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

# ---- Application ----
SERVER_PORT=8080

# ---- Brevo transactional email ----
# Used only with SPRING_PROFILES_ACTIVE=prod or brevo. Never commit the real API key.
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=notifications@relaynest.tech
BREVO_SENDER_NAME="RelayNest Notifications"
# Optional, but recommended until a dedicated support inbox is configured.
BREVO_REPLY_TO_EMAIL=
BREVO_EMAIL_SUBJECT="RelayNest notification"
# Credentials used by Brevo's Basic-authenticated webhook URL; generate unique values.
BREVO_WEBHOOK_USERNAME=
BREVO_WEBHOOK_PASSWORD=

# ---- Graceful shutdown ----
# Budget per shutdown phase (HTTP drain, then RabbitMQ listener drain). A containerized
# app needs stop_grace_period comfortably above the sum — see docker-compose.yml.
SHUTDOWN_TIMEOUT=30s
# How long the RabbitMQ listeners may spend finishing in-flight deliveries.
# Keep below SHUTDOWN_TIMEOUT.
LISTENER_SHUTDOWN_TIMEOUT=25s

# ---- Lease reconciler ----
# A SENDING claim older than this is presumed abandoned and is redelivered. Must exceed
# the slowest single provider call; too short and slow sends are delivered twice.
RECONCILER_LEASE_TIMEOUT=60s
# Delay between sweeps. ISO-8601 (PT30S) or milliseconds — not "30s".
RECONCILER_SWEEP_INTERVAL=PT30S
# An unpublished PENDING row younger than this is not republished yet (its create() may
# still be publishing it). Must exceed the 5s connection timeout + PUBLISHER_CONFIRM_TIMEOUT.
RECONCILER_PUBLISH_GRACE=15s
# A PENDING row that has used up its retries is marked DEAD by the reconciler once its
# last attempt is older than this (its dead-letter handler could not write DEAD). Must
# exceed one provider call plus the dead-letter handler's retry (~1.5s).
RECONCILER_DEAD_GRACE=60s

# ---- Publisher ----
# How long a publish waits for RabbitMQ's confirm before the reconciler takes it over.
PUBLISHER_CONFIRM_TIMEOUT=5s

# ---- Tenant seeding (local development only) ----
# Set to false in any deployed environment and provision tenants deliberately:
# generate a random key, give it to the client once, store only its SHA-256 hash.
SEED_TENANTS_ENABLED=true
# These are the documented development keys used by the README's curl examples and the
# k6 script. Only their hashes are ever written to the database.
ACME_API_KEY=key-acme
ACME_RATE_LIMIT=60
GLOBEX_API_KEY=key-globex
GLOBEX_RATE_LIMIT=10
INITECH_API_KEY=key-initech
INITECH_RATE_LIMIT=5
